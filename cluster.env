# Cluster IPv4 addresses used by the controller and compute-node scripts.
# Update both machines' configuration if the 7680 receives a different DHCP address.
SLURM_CONTROLLER_IP=192.168.1.185
SLURM_COMPUTE_IP=192.168.1.199
SLURM_CLUSTER_NAME=lagrange
SLURM_SRUN_PORT_RANGE=60001-63000
SLURM_SHARED_EXPORT=/srv/slurm-share
SLURM_SHARED_MOUNT=/cluster
